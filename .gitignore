.DS_Store
**/__pycache__/
*.pyc
.memos/

# This is a reusable template repository, not a media archive.
# Keep generated/large media out of Git. Store accepted renders and DUIX outputs
# locally or in GitHub Releases/object storage when needed.
*.mp4
*.mov
*.m4a
*.wav
*.tgz

# Small visual references are allowed.
!*.jpg
!*.jpeg
!*.png

# The accepted first 120s baseline template is part of the project, not a
# generated output archive. Keep its source HTML, docs, reference frames, and
# required template media in Git so a fresh clone has the visual source of truth.
!first120-template-duix/
!first120-template-duix/**
first120-template-duix/render/
first120-template-duix/assets/_backup_before_cosy_master_v2/
first120-template-duix/**/.DS_Store

# HyperFrames render caches and intermediate assembly files.
first390-template-locked/render/work-*/
first390-template-locked/render/assemble*/

# Keep only the final QA sheet by default.
first390-template-locked/audit/final-v1/
first390-template-locked/audit/final-v2/
first390-template-locked/audit/final-v3/
first390-template-locked/audit/motion/
first390-template-locked/audit/subtitle-fix/
